<% content_for :title, @figure_type.name %>
<header class="page-header">
  <h1><%= @figure_type.name %></h1>
  <p class="muted"><%= category_label(@figure_type.category) %> · <%= pluralize(@figures.size, "figure") %></p>
  <%= render "shared/page_actions", record: @figure_type, edit: edit_figure_type_path(@figure_type), history: history_figure_type_path(@figure_type) %>
</header>
<div class="prose"><%= wiki_body(@figure_type.body) %></div>
<ul>
  <% @figures.each do |figure| %>
    <li><%= link_to figure.name, figure %> <span class="muted">· <% if figure.seat %><%= seat_link(figure.seat) %><% else %><%= link_to figure.carousel.name, figure.carousel %> (not currently seated)<% end %></span></li>
  <% end %>
</ul>
