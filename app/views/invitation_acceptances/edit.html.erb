<% content_for :title, "Join carousel-o-pedia" %>
<h1>Join carousel-o-pedia</h1>
<p><%= @invitation.invited_by.name %> invited <strong><%= @invitation.email_address %></strong> to help edit.</p>
<%= form_with model: @user, url: invitation_acceptance_path(@invitation.token), method: :patch, scope: :user, class: "form narrow" do |form| %>
  <%= render "shared/errors", record: @user %>
  <div class="field"><%= form.label :name, "Your name" %><%= form.text_field :name, required: true, autofocus: true, autocomplete: "name" %></div>
  <div class="field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %></div>
  <div class="field"><%= form.label :password_confirmation, "Password again" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></div>
  <div class="actions"><%= form.submit "Create my account" %></div>
<% end %>
