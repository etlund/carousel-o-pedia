<% content_for :title, "Create draft layout for #{@carousel.name}" %>
<p class="muted"><%= link_to @carousel.name, @carousel %></p>
<h1><%= @draft.sketch? ? "Sketch carousel layout" : "Create draft layout" %></h1>
<% if @layout.is_a?(CarouselDeck) %>
  <p><strong><%= @layout.name %> only.</strong> Use this deck's counts and rows, not carousel-wide totals. Unknown allocations are not divided automatically.</p>
<% end %>
<%= render "shared/errors", record: @draft %>
<% if @layout.layout_known? || @layout.seats.any? %>
  <p>A seating layout already exists. This workflow will not replace it.</p>
  <p><%= link_to "Fill unknown seats", new_carousel_seat_fill_path(@carousel, deck_id: params[:deck_id]) %> or edit individual placements.</p>
<% else %>
  <p>Turn incomplete inventory research into an explicitly provisional seating chart.
    No changes are saved until you review the preview.</p>
  <% if @draft.sketch? %>
    <p>Enter horses, other animals, chariots, and rows to sketch a regular wheel. Horses and other animals
      are added together to size the layout. If other animals are included, animal positions stay unclassified
      until researched. Chariots are spread around the platform.
      Extra positions are marked as assumed empty, immediately inward of chariots in the same section
      when space allows. Nothing here establishes the actual seating arrangement.</p>
    <p>For specific seat positions or figure types,
      <%= link_to "use the detailed layout", new_carousel_layout_draft_path(@carousel, deck_id: params[:deck_id], layout_draft: LayoutDraft.defaults_for(@layout).merge(input_mode: "layout")) %>.
      Unequal rings cannot be represented by this regular-grid sketch.</p>
  <% else %>
    <p><%= link_to "Use the simple sketch", new_carousel_layout_draft_path(@carousel, deck_id: params[:deck_id]) %> for animal totals, chariots, and rows.</p>
  <% end %>
  <%= form_with model: @draft, scope: :layout_draft, url: preview_carousel_layout_draft_path(@carousel, deck_id: params[:deck_id]), method: :post, class: "form", data: { turbo: false } do |form| %>
    <%= form.hidden_field :input_mode %>
    <% if @draft.sketch? %>
      <fieldset>
        <legend>Sketch from counts</legend>
        <div class="field-row">
          <div class="field"><%= form.label :horses_count, "Horses" %><%= form.number_field :horses_count, min: 0, required: true %></div>
          <div class="field"><%= form.label :other_animals_count, "Other animals" %><%= form.number_field :other_animals_count, min: 0, required: true %></div>
          <div class="field"><%= form.label :chariots_count, "Chariots" %><%= form.number_field :chariots_count, min: 0, required: true %></div>
          <div class="field"><%= form.label :rows_count, "Rows" %><%= form.number_field :rows_count, min: 1, max: Carousel::MAX_ROWS, required: true %></div>
        </div>
        <p class="hint">Rows run from the outside inward. Count each chariot once, not its passengers. Unknown is not zero; enter zero only when no chariots are intended in this sketch. These draft counts do not change published totals.</p>
      </fieldset>
      <details id="chariot-footprint" <%= "open" if params[:layout_draft].present? %>>
        <summary>Adjust chariot footprint</summary>
        <div class="field"><%= form.label :chariot_rows_spanned, "Rows per chariot" %><%= form.select :chariot_rows_spanned, (1..Carousel::MAX_ROWS).map { [ pluralize(_1, "row"), _1 ] } %></div>
        <p class="hint">Initially two rows, or one for a single-row carousel. This is an assumption, not a verified footprint. Use one when sketching a single row.</p>
      </details>
    <% else %>
    <fieldset>
      <legend>Provisional platform</legend>
      <div class="field-row">
        <div class="field"><%= form.label :sections_count, "Sections" %><%= form.number_field :sections_count, min: 1, required: true %></div>
        <div class="field"><%= form.label :rows_count, "Rows" %><%= form.number_field :rows_count, min: 1, max: Carousel::MAX_ROWS, required: true %></div>
      </div>
      <p class="hint">Rows run from A outside inward. Review these dimensions carefully before creating the draft.</p>
    </fieldset>
    <fieldset>
      <legend>Default figures</legend>
      <div class="field-row">
        <div class="field">
          <%= form.label :figure_type_id, "Figure type" %>
          <%= form.collection_select :figure_type_id, FigureType.order(:name), :id, :name, { prompt: "Choose a type" }, required: true %>
        </div>
        <div class="field">
          <%= form.label :mount, "Motion" %>
          <%= form.select :mount, Figure::MOUNTS.map { [ _1.capitalize, _1 ] }, include_blank: "Unknown" %>
        </div>
      </div>
      <p class="hint">Every position not covered by a chariot or marked empty gets a provisional figure of this type.</p>
    </fieldset>
    <fieldset>
      <legend>Chariots and empty positions</legend>
      <div class="field-row">
        <div class="field">
          <%= form.label :chariot_type_id, "Chariot type" %>
          <%= form.collection_select :chariot_type_id, FigureType.where(category: "chariot").order(:name), :id, :name, include_blank: "Choose a type" %>
        </div>
        <div class="field">
          <%= form.label :chariot_rows_spanned, "Rows per chariot" %>
          <%= form.number_field :chariot_rows_spanned, min: 1, max: Carousel::MAX_ROWS, required: true %>
        </div>
      </div>
      <div class="field">
        <%= form.label :chariot_seats, "Chariot starting seats" %>
        <%= form.text_field :chariot_seats, placeholder: "1A, 10A" %>
        <p class="hint">One starting seat per chariot, separated by commas or spaces. A chariot at 1A spanning two rows fills 1A-1B as one figure. Two rows is an approximation you can change before saving. Chariots use fixed motion in this draft.</p>
      </div>
      <div class="field">
        <%= form.label :empty_seats, "Empty seats" %>
        <%= form.text_field :empty_seats, placeholder: "1C, 10C" %>
        <p class="hint">Optional seat codes for empty positions. Do not list positions already covered by a chariot.</p>
      </div>
    </fieldset>
    <% end %>
    <div class="field">
      <%= form.label :source_notes, "Source and research notes" %>
      <%= form.text_area :source_notes, rows: 6, required: true %>
      <p class="hint">Use Markdown links, source dates, and uncertainty notes. Existing summary research is prefilled when available. Your notes and the draft assumptions are saved with the carousel and each new figure.</p>
    </div>
    <div class="actions"><%= form.submit @draft.sketch? ? "Preview sketch" : "Preview draft layout" %> <%= link_to "Cancel", @carousel %></div>
  <% end %>
<% end %>
