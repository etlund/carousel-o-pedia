<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= safe_join([ content_for(:title), "carousel-o-pedia" ].compact, " · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="carousel-o-pedia">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="<%= content_for?(:favicon) ? yield(:favicon) : "/icon.svg" %>" type="image/svg+xml" data-turbo-track="dynamic">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rye&family=Figtree:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="dots" aria-hidden="true"></div>
    <header class="site-header">
      <%= link_to root_path, class: "brand", aria: { label: "carousel-o-pedia" } do %>
        <span>carousel-</span>
        <%= image_tag "/icon.svg", alt: "", width: 20, height: 20 %>
        <span>-pedia</span>
      <% end %>
      <nav>
        <%= link_to "Carousels", carousels_path %>
        <%= link_to "Figures", figures_path %>
        <%= link_to "Types", figure_types_path %>
        <%= link_to "Makers", makers_path %>
        <%= link_to "Recent changes", recent_changes_path %>
      </nav>
      <nav class="account">
        <% if authenticated? %>
          <% if current_user.admin? %><%= link_to "Invitations", invitations_path %><% end %>
          <span class="muted"><%= current_user.name %></span>
          <% unless current_user.contribution_terms_accepted? %>
            <%= link_to "Review contribution terms", edit_contribution_agreement_path %>
          <% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
        <% end %>
      </nav>
    </header>
    <main class="wrap">
      <% flash.each do |type, message| %>
        <p class="flash <%= type %>" role="status"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <nav aria-label="About and contributing">
        <%= link_to "About / Contribute", about_path %>
        <%= link_to "Editor guide", editor_guide_path %>
        <%= link_to "Contribution terms & privacy", contribution_terms_path %>
      </nav>
    </footer>
  </body>
</html>
