<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Carousel-pedia" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Carousel-pedia">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rye&family=Figtree:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="dots" aria-hidden="true"></div>
    <header class="site-header">
      <%= link_to "Carousel-pedia", root_path, class: "brand" %>
      <nav>
        <%= link_to "Carousels", carousels_path %>
        <%= link_to "Figures", figures_path %>
        <%= link_to "Types", figure_types_path %>
      </nav>
    </header>
    <main class="wrap">
      <%= yield %>
    </main>
  </body>
</html>
