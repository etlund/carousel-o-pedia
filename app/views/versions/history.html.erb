<% title = @record.is_a?(Seat) ? "#{@record.carousel.name} seat #{@record.display_code}" : @record.name %>
<% content_for :title, "History of #{title}" %>
<header class="page-header">
  <p class="muted"><%= link_to title, @record.is_a?(Seat) ? seat_record_path(@record) : (@record.is_a?(CarouselDeck) ? carousel_deck_path(@record.carousel, @record) : @record) %></p>
  <h1>History</h1>
</header>
<% if @versions.any? %>
  <ol class="versions"><%= render partial: "versions/version", collection: @versions %></ol>
<% else %>
  <p>No changes recorded yet.</p>
<% end %>
