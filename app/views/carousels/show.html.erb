<% content_for :title, @carousel.name %>
<% content_for :favicon, carousel_favicon_data_uri(@carousel) %>
<header class="page-header">
  <h1><%= @carousel.name %></h1>
  <p class="muted address"><%= @carousel.address %></p>
  <p><%= link_to "View all figures", figures_path(carousel_id: @carousel.id) %></p>
  <%= render "shared/page_actions", edit: edit_carousel_path(@carousel), history: history_carousel_path(@carousel) %>
</header>

<div class="grid">
  <div class="card">
    <% if @carousel.layout_known? %>
      <%= render "seat_chart", carousel: @carousel %>
    <% elsif @carousel.ring_details.present? %>
      <%= render "ring_chart", carousel: @carousel %>
    <% else %>
      <p class="layout-unknown">No seating layout has been recorded yet.</p>
    <% end %>
    <% if @carousel.layout_known? && @carousel.ring_details.present? %>
      <%= render "ring_chart", carousel: @carousel %>
    <% end %>
  </div>
  <div class="stack">
    <dl class="facts card">
      <dt>Platform</dt><dd><%= carousel_platform_label(@carousel) || "Unknown" %></dd>
      <dt>Rotation</dt><dd><%= @carousel.rotation || "Unknown" %></dd>
      <% FigureType::CATEGORIES.each do |category| %>
        <dt><%= category_label(category) %></dt><dd class="figure-count"><%= carousel_figure_count(@carousel, category, @totals.fetch(category)) || "Unknown" %></dd>
      <% end %>
      <% if (lead = @carousel.lead_figure) %><dt>Lead figure</dt><dd><%= link_to lead.name, lead %></dd><% end %>
      <dt>Status</dt><dd><%= @carousel.status.capitalize %></dd>
      <% if @carousel.maker %><dt>Maker</dt><dd><%= link_to @carousel.maker.name, @carousel.maker %></dd><% end %>
      <% if @carousel.year_opened %><dt>Opened</dt><dd><%= @carousel.year_opened %></dd><% end %>
      <% if @carousel.official_url %><dt>Website</dt><dd><%= link_to "Official website", @carousel.official_url, class: "website-link" %></dd><% end %>
      <% if @carousel.wikipedia_url %><dt>Wikipedia</dt><dd><%= link_to "Wikipedia", @carousel.wikipedia_url %></dd><% end %>
      <% if @carousel.other_links %><dt>Other links</dt><dd class="prose"><%= wiki_body(@carousel.other_links) %></dd><% end %>
    </dl>
    <% if @carousel.address_sources.present? %>
      <section id="address-sources" class="prose">
        <h2>Address sources</h2>
        <%= wiki_body(@carousel.address_sources) %>
      </section>
    <% end %>
    <% if @carousel.summary_sources.present? %>
      <section id="summary-sources" class="prose">
        <h2>Summary sources</h2>
        <%= wiki_body(@carousel.summary_sources) %>
      </section>
    <% end %>
    <div class="prose"><%= wiki_body(@carousel.body) %></div>
  </div>
</div>

<% if @carousel.layout_known? %>
<h2>Sections</h2>
<p class="muted">Seat codes are section number plus row letter. Row A is the outer row. Occupied seats open their figure; empty and unknown seats open their placement details.</p>
<div class="table-scroll">
  <table class="sections">
    <thead>
      <tr>
        <th>Section</th>
        <% @carousel.row_letters.each do |letter| %><th><%= letter %></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% @sections.each do |section| %>
        <tr>
          <th scope="row"><%= section[:number] %></th>
          <% skip = 0 %>
          <% @carousel.row_letters.each do |letter| %>
            <% if skip > 0 %><% skip -= 1 %><% next %><% end %>
            <% seat = section[:seats][letter] %>
            <% if seat %>
              <% skip = seat.rows_spanned - 1 %>
              <td colspan="<%= seat.rows_spanned %>" class="<%= seat.category || seat.state %>">
                <%= link_to seat.figure&.name || seat.state.capitalize, seat_destination_path(seat) %>
                <% unless seat.confirmed? %><span class="badge">check</span><% end %>
              </td>
            <% else %>
              <td class="none">none</td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% end %>
