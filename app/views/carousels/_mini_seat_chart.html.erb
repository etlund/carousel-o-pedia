<%= link_to carousel, class: "mini-seat-chart-link", aria: { label: "View seating chart for #{carousel.name}" } do %>
  <svg class="mini-seat-chart" viewBox="22 22 756 756" width="112" height="112" role="img"
       aria-label="Seat chart preview of <%= carousel.name %>. Light blue: horses; orange: other animals; red: chariots and tubs. Solid wedges: confirmed placements; colored outlines: best-reading placements; gray outlines: unknown or empty seats.">
    <%= render "seat_wedges", carousel:, seats: carousel.seats %>
  </svg>
<% end %>
