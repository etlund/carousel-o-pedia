<% preview_description = if carousel.layout_known?
  "Blue: horses; orange: other animals; red: chariots and tubs. Base category fills: confirmed placements; faded fills: best-reading placements; unfilled wedges: unknown or empty seats. All wedges have gray outlines."
elsif carousel.ring_details.present?
  "Independent ring research; unknown position counts stay unsegmented. Equal spacing is schematic, not verified seating."
else
  carousel.rows_count ? "#{pluralize(carousel.rows_count, "row")} shown as concentric rings; sections and seat positions unknown." : "Layout unknown; inner and outer platform outlines only."
end %>
<% preview_description = "Provisional layout. #{preview_description}" if carousel.layout_provisional? %>
<%= link_to carousel, class: "mini-seat-chart-link", aria: { label: "#{carousel.layout_known? ? "View seating chart" : "View carousel details"} for #{carousel.name}" } do %>
  <svg class="mini-seat-chart" viewBox="22 22 756 756" width="112" height="112" role="img"
       aria-label="Seat chart preview of <%= carousel.name %>. <%= preview_description %>">
    <% if carousel.layout_known? %>
      <%= render "seat_wedges", carousel:, seats: carousel.seats %>
    <% elsif carousel.ring_details.present? %>
      <%= render "ring_bands", carousel: %>
    <% else %>
      <path class="mini-seat-platform"
            d="<%= wedge_path(SeatChart::HUB_RADIUS, SeatChart::PLATFORM_RADIUS, half_angle: Math::PI, center_x: SeatChart::CENTER, center_y: SeatChart::CENTER) %>"/>
      <% if carousel.rows_count %>
        <% (1...carousel.rows_count).each do |row| %>
          <circle class="mini-seat-row-divider" cx="<%= SeatChart::CENTER %>" cy="<%= SeatChart::CENTER %>"
                  r="<%= SeatChart::HUB_RADIUS + row * (SeatChart::PLATFORM_RADIUS - SeatChart::HUB_RADIUS).to_f / carousel.rows_count %>"/>
        <% end %>
      <% end %>
    <% end %>
  </svg>
<% end %>
