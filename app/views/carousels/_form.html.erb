<%= form_with model: carousel, class: "form" do |form| %>
  <%= render "shared/errors", record: carousel %>
  <div class="field"><%= form.label :name %><%= form.text_field :name, required: true %></div>
  <div class="field">
    <%= form.label :other_names %><%= form.text_area :other_names, rows: 3 %>
    <p class="hint">Optional alternate or historical names for this same carousel, one per line. These names are searchable; keep the primary name above.</p>
  </div>
  <div class="field"><%= form.label :status %><%= form.select :status, Carousel::STATUSES.map { [ _1.capitalize, _1 ] } %></div>
  <div class="field"><%= form.label :maker_id, "Maker" %><%= form.collection_select :maker_id, Maker.order(:name), :id, :name, include_blank: "Unknown" %></div>
  <div class="field-row">
    <div class="field"><%= form.label :year_built %><%= form.number_field :year_built %></div>
    <div class="field"><%= form.label :year_opened %><%= form.number_field :year_opened %></div>
  </div>
  <div class="field"><%= form.label :venue %><%= form.text_field :venue %></div>
  <div class="field">
    <%= form.label :street_address %><%= form.text_field :street_address, autocomplete: "street-address" %>
    <p class="hint">Use the public ride location or visitor entrance, not a mailing office or PO box. Note when this is a park or venue address rather than the carousel's own door.</p>
  </div>
  <div class="field-row">
    <div class="field"><%= form.label :city %><%= form.text_field :city %></div>
    <div class="field"><%= form.label :region, "State or region" %><%= form.text_field :region %></div>
    <div class="field"><%= form.label :postal_code, "ZIP or postal code" %><%= form.text_field :postal_code, autocomplete: "postal-code" %></div>
    <div class="field"><%= form.label :country %><%= form.text_field :country %></div>
  </div>
  <div class="field">
    <%= form.label :address_sources, "Address sources and notes" %><%= form.text_area :address_sources, rows: 3 %>
    <p class="hint">Use Markdown links, a review date, and any entrance or address-precision caveats. An address does not establish the carousel's exact map coordinates.</p>
  </div>
  <%= render "shared/body_field", form: %>
  <fieldset>
    <legend>Website links</legend>
    <div class="field"><%= form.label :official_url, "Official website URL" %><%= form.url_field :official_url, placeholder: "https://example.com" %></div>
    <div class="field"><%= form.label :wikipedia_url, "Wikipedia URL" %><%= form.url_field :wikipedia_url, placeholder: "https://en.wikipedia.org/wiki/..." %></div>
    <div class="field">
      <%= form.label :other_links, "Other links" %>
      <%= form.text_area :other_links, rows: 4 %>
      <p class="hint">Optional named links, one per line. Use Markdown, for example [NCA gallery](https://carousels.org/). The official website URL appears as a separate link on carousel summary cards.</p>
    </div>
  </fieldset>
  <fieldset>
    <legend>Platform</legend>
    <% if carousel.new_record? || carousel.sections_count_in_database.nil? || carousel.rows_count_in_database.nil? %>
      <div class="field-row">
        <div class="field"><%= form.label :sections_count, "Sections" %><%= form.number_field :sections_count, min: 1 %></div>
        <div class="field"><%= form.label :rows_count, "Rows" %><%= form.number_field :rows_count, min: 1, max: Carousel::MAX_ROWS %></div>
      </div>
      <p class="hint">Record only verified dimensions; either count can remain blank. Sections run around the platform and rows run from the outside in. A chart is created only when both are known; its size is then fixed.</p>
      <% if carousel.persisted? %>
        <p class="hint">For an estimate based on inventory counts, <%= link_to "Create draft layout", new_carousel_layout_draft_path(carousel) %> instead. Draft geometry stays explicitly provisional.</p>
      <% end %>
    <% else %>
      <p><%= pluralize(carousel.sections_count, "section") %> × <%= pluralize(carousel.rows_count, "row") %>. The size can't change once seats exist.</p>
      <div class="field">
        <%= form.label :lead_seat_id, "Lead figure (section 1)" %>
        <%= form.select :lead_seat_id,
              carousel.seats.where(row: "A").includes(current_placement: :figure).map { |seat| [ "#{seat.code} · #{seat.figure&.name || seat.state.capitalize}", seat.id ] },
              { selected: carousel.lead_seat&.id } %>
        <p class="hint">The lead figure's section becomes section 1 and its outer-row seat becomes 1A. Every other section is renumbered from there, in the order figures pass the rail.</p>
      </div>
      <div>
        <%= form.label :layout_provisional do %>
          <%= form.check_box :layout_provisional %> Provisional layout (geometry not yet verified)
        <% end %>
        <p class="hint">Keep this checked while section alignment or chariot footprints are assumptions. Uncheck only after verifying the layout and recording supporting evidence in Summary sources.</p>
      </div>
    <% end %>
    <div class="field"><%= form.label :rotation, "Turns" %><%= form.select :rotation, Carousel::ROTATIONS.map { [ _1.capitalize, _1 ] }, include_blank: "Unknown" %></div>
  </fieldset>
  <fieldset>
    <legend>Published totals</legend>
    <p class="hint">Source-reported riding figures, separate from our mapped seats. Count vehicles, not passengers. Leave unverified counts blank; zero means the source confirms none.</p>
    <div class="field-row">
      <div class="field"><%= form.label :published_horses_count, "Published horses" %><%= form.number_field :published_horses_count, min: 0 %></div>
      <div class="field"><%= form.label :published_other_animals_count, "Published other animals" %><%= form.number_field :published_other_animals_count, min: 0 %></div>
      <div class="field"><%= form.label :published_chariots_count, "Published chariots and tubs" %><%= form.number_field :published_chariots_count, min: 0 %></div>
    </div>
    <div class="field">
      <%= form.label :summary_sources, "Summary sources and notes" %>
      <%= form.text_area :summary_sources, rows: 5 %>
      <p class="hint">Required for published totals. Use Markdown links, source dates, and any caveats; also cite partial layout facts here.</p>
    </div>
  </fieldset>
  <fieldset>
    <legend>Independent ring research</legend>
    <p class="hint">Optional counts per ring, even when rings have unequal numbers of positions or no mapped seats. A is the outer ring. Set the verified platform row count; leave unknown values blank. Total positions include vehicles; horses alone do not establish that total. Horse motion describes the horses in that ring, not chariots. Cite the source and uncertainty in Summary sources. This schematic does not create seats or change an existing seat map.</p>
    <%= form.fields_for :ring_details do |rings| %>
      <% ("A"..).first(Carousel::MAX_ROWS).each do |letter| %>
        <% details = carousel.ring_details.is_a?(Hash) && carousel.ring_details[letter].is_a?(Hash) ? carousel.ring_details[letter] : {} %>
        <fieldset>
          <legend>Row <%= letter %><%= " (outer)" if letter == "A" %></legend>
          <%= rings.fields_for letter do |ring| %>
            <div class="field-row">
              <div class="field"><%= ring.label :positions_count, "Total positions" %><%= ring.number_field :positions_count, value: details["positions_count"], min: 0 %></div>
              <div class="field"><%= ring.label :horses_count, "Horses" %><%= ring.number_field :horses_count, value: details["horses_count"], min: 0 %></div>
              <div class="field"><%= ring.label :mount, "Horse motion" %><%= ring.select :mount, Carousel::RING_MOUNTS.map { [ _1.capitalize, _1 ] }, selected: details["mount"], include_blank: "Unknown" %></div>
            </div>
          <% end %>
        </fieldset>
      <% end %>
    <% end %>
  </fieldset>
  <div class="actions"><%= form.submit %> <%= link_to "Cancel", carousel.persisted? ? carousel : carousels_path %></div>
<% end %>
