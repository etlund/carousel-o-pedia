<%= form_with model: carousel, class: "form" do |form| %>
  <%= render "shared/errors", record: carousel %>
  <div class="field"><%= form.label :name %><%= form.text_field :name, required: true %></div>
  <div class="field-row">
    <div class="field"><%= form.label :city %><%= form.text_field :city %></div>
    <div class="field"><%= form.label :region, "State or region" %><%= form.text_field :region %></div>
    <div class="field"><%= form.label :country %><%= form.text_field :country %></div>
  </div>
  <div class="field"><%= form.label :venue %><%= form.text_field :venue %></div>
  <div class="field-row">
    <div class="field"><%= form.label :status %><%= form.select :status, Carousel::STATUSES.map { [ _1.capitalize, _1 ] } %></div>
    <div class="field"><%= form.label :year_built %><%= form.number_field :year_built %></div>
    <div class="field"><%= form.label :year_opened %><%= form.number_field :year_opened %></div>
  </div>
  <div class="field"><%= form.label :maker_id, "Maker" %><%= form.collection_select :maker_id, Maker.order(:name), :id, :name, include_blank: "Unknown" %></div>
  <fieldset>
    <legend>Platform</legend>
    <% if carousel.new_record? %>
      <div class="field-row">
        <div class="field"><%= form.label :sections_count, "Sections" %><%= form.number_field :sections_count, min: 1, required: true %></div>
        <div class="field"><%= form.label :rows_count, "Rows" %><%= form.number_field :rows_count, min: 1, max: Carousel::MAX_ROWS, required: true %></div>
      </div>
      <p class="hint">Count sections around the platform and rows from the outside in. Every seat starts as unknown.</p>
    <% else %>
      <p><%= pluralize(carousel.sections_count, "section") %> × <%= pluralize(carousel.rows_count, "row") %>. The size can't change once seats exist.</p>
      <div class="field">
        <%= form.label :lead_seat_id, "Lead figure (section 1)" %>
        <%= form.select :lead_seat_id,
              carousel.seats.where(row: "A").includes(current_placement: :figure).map { |seat| [ "#{seat.code} · #{seat.figure&.name || seat.state.capitalize}", seat.id ] },
              { selected: carousel.lead_seat&.id } %>
        <p class="hint">The lead figure's section becomes section 1 and its outer-row seat becomes 1A. Every other section is renumbered from there, in the order figures pass the rail.</p>
      </div>
    <% end %>
    <div class="field"><%= form.label :rotation, "Turns" %><%= form.select :rotation, Carousel::ROTATIONS.map { [ _1.capitalize, _1 ] } %></div>
  </fieldset>
  <%= render "shared/body_field", form: %>
  <div class="actions"><%= form.submit %> <%= link_to "Cancel", carousel.persisted? ? carousel : carousels_path %></div>
<% end %>
