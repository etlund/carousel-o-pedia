<% content_for :title, "Carousels" %>
<header class="page-header">
  <h1>Carousels</h1>
  <% if authenticated? %><p class="page-actions"><%= link_to "Add a carousel", new_carousel_path, class: "button" %></p><% end %>
</header>
<%= form_with url: carousels_path, method: :get, class: "form" do |form| %>
  <div class="field-row">
    <div class="field">
      <%= form.label :q, "Name" %>
      <%= form.search_field :q, value: @query, placeholder: "Search carousel names" %>
    </div>
    <div class="field">
      <%= form.label :region, "State" %>
      <%= form.select :region, @regions, include_blank: "All states", selected: @selected_region %>
    </div>
    <div class="field">
      <%= form.label :sort, "Sort" %>
      <%= form.select :sort, [ [ "With data first", "data_first" ], [ "Name (A-Z)", "name" ] ], selected: @sort %>
    </div>
  </div>
  <div class="actions"><%= form.submit "Filter" %> <%= link_to "Clear filters", carousels_path %></div>
<% end %>
<% if @carousels.empty? %>
  <p>No carousels match these filters.</p>
<% else %>
<ul class="cards">
  <% @carousels.each do |carousel| %>
    <li class="card">
      <h2><%= link_to carousel.name, carousel %></h2>
      <p class="muted"><%= carousel.location %></p>
      <% if carousel.official_url.present? %><p class="website"><%= link_to carousel.official_url, carousel.official_url, class: "website-link" %></p><% end %>
      <p><%= carousel_platform_label(carousel) || "Layout unknown" %>, <%= carousel.status %></p>
      <dl class="facts">
        <% FigureType::CATEGORIES.each do |category| %>
          <dt><%= category_label(category) %></dt>
          <dd class="figure-count"><%= carousel_figure_count(carousel, category, @category_counts.fetch([carousel.id, category], 0)) || "Unknown" %></dd>
        <% end %>
      </dl>
      <% if carousel.summary_sources.present? %>
        <p><%= link_to "Summary sources", carousel_path(carousel, anchor: "summary-sources") %></p>
      <% end %>
    </li>
  <% end %>
</ul>
<% end %>
