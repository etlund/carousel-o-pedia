<% content_for :title, "Carousels" %>
<header class="page-header">
  <h1>Carousels</h1>
  <% if current_user&.can_create_carousel? %><p class="page-actions"><%= link_to "Add a carousel", new_carousel_path, class: "button" %></p><% end %>
  <% if current_user&.admin? %><p class="page-actions"><%= link_to "Import / export CSV", carousel_csv_path %></p><% end %>
</header>
<%= form_with url: carousels_path, method: :get, class: "form" do |form| %>
  <div class="field-row">
    <div class="field">
      <%= form.label :q, "Name" %>
      <%= form.search_field :q, value: @query, placeholder: "Search carousel names" %>
    </div>
    <div class="field">
      <%= form.label :country, "Country" %>
      <%= form.select :country, @country_counts.map { |country, count| [ "#{country} (#{number_with_delimiter(count)})", country ] }, include_blank: "All countries", selected: @selected_country %>
    </div>
    <div class="field">
      <%= form.label :region, "State" %>
      <%= form.select :region, @region_counts.map { |region, count| [ "#{region} (#{number_with_delimiter(count)})", region ] }, include_blank: "All states", selected: @selected_region %>
    </div>
    <div class="field">
      <%= form.label :sort, "Sort" %>
      <%= form.select :sort, [ [ "Name (A-Z)", "name" ], [ "Last updated", "updated" ], [ "Most complete", "completeness" ] ], selected: @sort %>
    </div>
  </div>
  <div class="actions"><%= form.submit "Filter" %> <%= link_to "Clear filters", carousels_path(clear_filters: 1) %></div>
<% end %>
<p class="muted carousel-count">
  <% if @query || @selected_region || @selected_country %><%= number_with_delimiter(@pagy.count) %> of <% end %><%= number_with_delimiter(@total_carousels) %> <%= "carousel".pluralize(@total_carousels) %> listed
</p>
<% if @pagy.count.zero? %>
  <p>No carousels match these filters.</p>
<% else %>
<ul class="cards">
  <% @carousels.each do |carousel| %>
    <li class="card">
      <h2><%= link_to carousel.name, carousel %></h2>
      <% if carousel.other_names.present? %><p class="muted other-names">Other names: <%= carousel.other_names.lines(chomp: true).join("; ") %></p><% end %>
      <p class="muted"><%= carousel.location %></p>
      <% if carousel.official_url.present? %><p class="website"><%= link_to carousel.official_url, carousel.official_url, class: "website-link" %></p><% end %>
      <p><% if carousel.decks_count %><%= pluralize(carousel.decks_count, "deck") %>; <% end %><%= carousel_platform_label(carousel) || "Layout unknown" %>, <%= carousel.status %></p>
      <div class="card-seating">
        <%= render "mini_seat_chart", carousel: %>
        <dl class="facts">
          <% FigureType::CATEGORIES.each do |category| %>
            <dt><%= category_label(category) %></dt>
            <dd class="figure-count"><%= carousel_figure_count(carousel, category, @category_counts.fetch([carousel.id, category], 0)) || "Unknown" %></dd>
          <% end %>
        </dl>
      </div>
      <p class="hint seating-completeness">Seating completeness: <%= carousel_seating_completeness_label(carousel) %></p>
      <% if carousel.summary_sources.present? %>
        <p><%= link_to "Summary sources", carousel_path(carousel, anchor: "summary-sources") %></p>
      <% end %>
    </li>
  <% end %>
</ul>
<% if @pagy.last > 1 %><%== @pagy.series_nav %><% end %>
<% end %>
