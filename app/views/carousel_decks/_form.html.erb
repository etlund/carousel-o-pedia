<%= form_with model: @deck, url: @deck.persisted? ? carousel_deck_path(@carousel, @deck) : carousel_decks_path(@carousel), class: "form" do |form| %>
  <%= render "shared/errors", record: @deck %>
  <div class="field"><%= form.label :name, "Deck name" %><%= form.text_field :name, required: true, placeholder: "Upper deck" %></div>
  <div class="field"><%= form.label :position, "Display order (lowest deck first)" %><%= form.number_field :position, min: 1, required: true %></div>
  <fieldset>
    <legend>Independent platform</legend>
    <div class="field-row">
      <div class="field"><%= form.label :sections_count, "Sections" %><%= form.number_field :sections_count, min: 1 %></div>
      <div class="field"><%= form.label :rows_count, "Rows" %><%= form.number_field :rows_count, min: 1, max: Carousel::MAX_ROWS %></div>
    </div>
    <p class="hint">Only this deck's dimensions. Leave unknown values blank; do not copy carousel-wide rows or divide totals between decks. Both dimensions create unknown seats on this deck. Resize safeguards protect figures, research, history, and spanning seats.</p>
    <div><%= form.label :layout_provisional do %><%= form.check_box :layout_provisional %> Provisional layout (geometry not yet verified)<% end %></div>
  </fieldset>
  <fieldset>
    <legend>Published totals for this deck only</legend>
    <div class="field-row">
      <div class="field"><%= form.label :published_horses_count, "Horses" %><%= form.number_field :published_horses_count, min: 0 %></div>
      <div class="field"><%= form.label :published_other_animals_count, "Other animals" %><%= form.number_field :published_other_animals_count, min: 0 %></div>
      <div class="field"><%= form.label :published_chariots_count, "Chariots" %><%= form.number_field :published_chariots_count, min: 0 %></div>
    </div>
    <p class="hint">Optional sourced allocations, not the carousel-wide totals. Blank means unknown; zero means verified none. These do not overwrite the carousel's totals.</p>
  </fieldset>
  <div class="field"><%= form.label :summary_sources, "Deck sources and notes" %><%= form.text_area :summary_sources, rows: 5 %></div>
  <div class="actions"><%= form.submit %><%= link_to "Cancel", @deck.persisted? ? carousel_deck_path(@carousel, @deck) : carousel_path(@carousel) %></div>
<% end %>
