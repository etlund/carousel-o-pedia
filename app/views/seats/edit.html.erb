<% content_for :title, "Edit #{@carousel.name} #{@seat.code}" %>
<p class="muted"><%= link_to @carousel.name, @carousel %></p>
<h1>Edit seat <%= @seat.code %></h1>
<%= form_with model: @seat, url: carousel_seat_path(@carousel, @seat), method: :patch, class: "form" do |form| %>
  <%= render "shared/errors", record: @seat %>
  <div class="field">
    <%= form.label :figure_id, "Figure in this seat" %>
    <%= form.select :figure_id,
          options_for_select([ [ "Unknown", "" ], [ "Empty", SeatsController::EMPTY ] ], @seat.figure ? nil : (@seat.state == "empty" ? SeatsController::EMPTY : "")) +
          options_from_collection_for_select(Figure.includes(seat: :carousel).order(:name), :id,
            ->(figure) { figure.seat && figure.seat != @seat ? "#{figure.name} (now #{figure.seat.carousel.name} #{figure.seat.code})" : figure.name }, @seat.figure&.id) %>
    <p class="hint">Choosing a figure that sits elsewhere moves it here. Its old seat becomes empty. Missing a figure? <%= link_to "Add it first", new_figure_path %>.</p>
  </div>
  <div class="field-row">
    <div class="field">
      <%= form.label :rows_spanned, "Rows it fills" %>
      <%= form.number_field :rows_spanned, min: 1, max: @carousel.rows_count - @seat.row_index %>
      <p class="hint">More than 1 for a tub or chariot that fills several rows, counted inward from row <%= @seat.row %>.</p>
    </div>
    <div class="field">
      <%= form.label :confidence %>
      <%= form.select :confidence, [ [ "Confirmed", "confirmed" ], [ "Best reading, not yet confirmed", "best_reading" ] ] %>
    </div>
  </div>
  <div class="actions"><%= form.submit "Save seat" %> <%= link_to "Cancel", carousel_seat_path(@carousel, @seat) %></div>
<% end %>
