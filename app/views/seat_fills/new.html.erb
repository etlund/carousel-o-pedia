<% content_for :title, "Fill unknown seats on #{@carousel.name}" %>
<p class="muted"><%= link_to @carousel.name, @carousel %></p>
<h1>Fill unknown seats</h1>
<%= render "shared/errors", record: @fill %>

<% if !@carousel.layout_known? %>
  <p>Record the carousel's sections and rows before filling unknown seats.</p>
  <p><%= link_to "Edit carousel layout", edit_carousel_path(@carousel) %></p>
  <p>Working from approximate inventory instead? <%= link_to "Create draft layout", new_carousel_layout_draft_path(@carousel) %> and review the assumptions before saving.</p>
<% elsif @fill.seats.empty? %>
  <p>There are no unknown seats to fill. Existing figures and empty seats will not be changed.</p>
<% else %>
  <p>Create a rough draft for <%= pluralize(@fill.seats.size, "unknown seat") %> on <%= @carousel.name %>.
    Existing figures and empty seats will not be changed. Place chariots and mark empty positions first.</p>
  <p>Each unknown seat gets a new figure with a provisional seat-based name, such as Horse 2A.
    All new placements are marked as best readings, not confirmed. Existing row spans are preserved.</p>
  <%= form_with model: @fill, scope: :seat_fill, url: preview_carousel_seat_fill_path(@carousel), method: :post, class: "form", data: { turbo: false } do |form| %>
    <div class="field-row">
      <div class="field">
        <%= form.label :figure_type_id, "Figure type" %>
        <%= form.collection_select :figure_type_id, FigureType.order(:name), :id, :name, { prompt: "Choose a type" }, required: true %>
      </div>
      <div class="field">
        <%= form.label :mount, "Motion" %>
        <%= form.select :mount, Figure::MOUNTS.map { [ _1.capitalize, _1 ] }, include_blank: "Unknown" %>
      </div>
    </div>
    <div class="field">
      <%= form.label :source_notes, "Source and research notes" %>
      <%= form.text_area :source_notes, rows: 5, required: true %>
      <p class="hint">Use Markdown links, source dates, and uncertainty notes. These notes are copied to every new figure's page. Individual markings and identities can be documented later.</p>
    </div>
    <div class="actions"><%= form.submit "Preview seats" %> <%= link_to "Cancel", @carousel %></div>
  <% end %>
<% end %>
